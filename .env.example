# Aegis.net Environment Variables
# Copy this file to .env and fill in your values

# Control Plane Configuration
AUTHORIZED_CLI_KEYS=your-ssh-public-key-here
WHITELISTED_IPS=127.0.0.1,your-ip-here
JWT_SECRET=change-this-to-random-secret
CLI_SESSION_TIMEOUT=3600
SECRET_KEY=change-this-to-random-secret-key

# Edge Nodes (comma-separated)
EDGE_NODES=http://edge1.example.com,http://edge2.example.com

# Database (for future use)
# DATABASE_URL=postgresql://user:password@postgres:5432/aegis
# REDIS_URL=redis://redis:6379/0

# Example .env file for Aegis.net Control Plane

# Application
APP_NAME="Aegis.net Control Plane"
DEBUG=false
SECRET_KEY="change-me-in-production-min-32-chars"

# Database
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/aegis"

# Redis
REDIS_URL="redis://localhost:6379/0"

# CORS (for dashboard)
CORS_ORIGINS='["http://localhost:3000", "http://localhost:5173", "https://aegis.net"]'

# Edge nodes
EDGE_NODES='["https://fra1.edge.aegis.net", "https://ams1.edge.aegis.net", "https://mow1.edge.aegis.net"]'

# Authentication (legacy - for web dashboard if needed)
ACCESS_TOKEN_EXPIRE_MINUTES=60
ALGORITHM="HS256"

# === CLI SECURITY SETTINGS ===

# JWT Secret for CLI sessions (MUST CHANGE IN PRODUCTION)
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET="CHANGE_THIS_TO_RANDOM_SECRET_MIN_32_CHARS"

# CLI session timeout (seconds)
CLI_SESSION_TIMEOUT=1800

# Authorized SSH public keys (JSON array)
# Add your SSH public keys here (from ~/.ssh/aegis_cli.pub)
AUTHORIZED_CLI_KEYS='[]'
# Example:
# AUTHORIZED_CLI_KEYS='["ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIxxxxxxxxxxxxx admin@aegis"]'

# IP whitelist for CLI access (JSON array)
# Empty list = allow all (NOT RECOMMENDED for production)
WHITELISTED_IPS='["127.0.0.1", "::1"]'
# Add your trusted IPs:
# WHITELISTED_IPS='["127.0.0.1", "::1", "203.0.113.1"]'

# Audit log retention
AUDIT_LOG_RETENTION_DAYS=90

# Rate limiting (API endpoints)
RATE_LIMIT_PER_MINUTE=100
